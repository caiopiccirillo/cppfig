# Inherits the project's checks and relaxes those that fit library code but
# not tests, fuzzers, benchmarks and examples: their literal values (ports,
# sizes, iteration counts) read better inline, test bodies and fuzz entry
# points are long by nature, and helpers taking two strings are clear at
# their few call sites.
#
# Examples also stand for application code: their settings would live in a
# header, so they keep external linkage, and main does not wrap its output in
# a try block.
InheritParentConfig: true
Checks: >
  -bugprone-easily-swappable-parameters,
  -bugprone-exception-escape,
  -misc-use-internal-linkage,
  -readability-function-cognitive-complexity,
  -readability-magic-numbers
