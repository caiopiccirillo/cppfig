# Docs.cmake
# Builds the Doxygen HTML documentation, styled with doxygen-awesome-css.
#
# Configuring downloads the theme and writes two files into the build tree:
#   Doxyfile          includes the project's Doxyfile and adds the theme files,
#                     the output directory and the settings that depend on the
#                     installed Doxygen version
#   docs-header.html  Doxygen's own header template for that version, with the
#                     theme's scripts added
#
# Usage:
#   cmake --workflow --preset docs     (HTML in build/docs/html)
#
# Public targets added:
#   docs            – build the Doxygen HTML documentation
#   docs-serve      – serve the HTML at http://localhost:8080 for preview

include(FetchContent)

find_package(Doxygen COMPONENTS dot QUIET)

if(NOT DOXYGEN_FOUND)
    message(STATUS "Doxygen not found — documentation targets disabled")
    return()
endif()

message(STATUS "Doxygen found: ${DOXYGEN_VERSION}")

FetchContent_Declare(doxygen_awesome_css
    URL https://github.com/jothepro/doxygen-awesome-css/archive/refs/tags/v2.5.0.zip
    URL_HASH SHA256=853d5939f724fd3b388b8a33f5459ba8a50a7972df3e721d7d66da05d82eea33
    DOWNLOAD_EXTRACT_TIMESTAMP TRUE
)
# The theme has no CMakeLists.txt, so this only downloads and extracts it.
FetchContent_MakeAvailable(doxygen_awesome_css)
set(_theme_dir "${doxygen_awesome_css_SOURCE_DIR}")

# The header template differs between Doxygen versions, so it is generated by
# the installed Doxygen rather than kept in the repository. The theme's
# extensions are loaded at the end of its <head>.
set(_header "${CMAKE_BINARY_DIR}/docs-header.html")
execute_process(
    COMMAND ${DOXYGEN_EXECUTABLE} -w html docs-header.html docs-footer.html docs-default.css
    WORKING_DIRECTORY ${CMAKE_BINARY_DIR}
    RESULT_VARIABLE _header_result
    OUTPUT_QUIET
)
if(NOT _header_result EQUAL 0 OR NOT EXISTS "${_header}")
    message(FATAL_ERROR "Doxygen could not write its default HTML header")
endif()
file(REMOVE "${CMAKE_BINARY_DIR}/docs-footer.html" "${CMAKE_BINARY_DIR}/docs-default.css")

set(_extensions darkmode-toggle fragment-copy-button paragraph-link)
set(_scripts "")
set(_init "")
set(_extra_files "")
foreach(_extension IN LISTS _extensions)
    string(APPEND _scripts "<script type=\"text/javascript\" src=\"$relpath^doxygen-awesome-${_extension}.js\"></script>\n")
    list(APPEND _extra_files "\"${_theme_dir}/doxygen-awesome-${_extension}.js\"")
endforeach()
string(APPEND _scripts
    "<script type=\"text/javascript\">\n"
    "DoxygenAwesomeDarkModeToggle.init()\n"
    "DoxygenAwesomeFragmentCopyButton.init()\n"
    "DoxygenAwesomeParagraphLink.init()\n"
    "</script>\n"
)
file(READ "${_header}" _header_text)
string(FIND "${_header_text}" "</head>" _head_end)
if(_head_end EQUAL -1)
    message(FATAL_ERROR "Doxygen's HTML header has no </head> to add the theme's scripts before")
endif()
string(REPLACE "</head>" "${_scripts}</head>" _header_text "${_header_text}")
file(WRITE "${_header}" "${_header_text}")

# Settings that older Doxygen versions do not know, so they would warn about
# them if they were in the project's Doxyfile.
set(_version_settings "")
if(DOXYGEN_VERSION VERSION_GREATER_EQUAL 1.10)
    # The theme's copy button replaces Doxygen's own.
    string(APPEND _version_settings "HTML_COPY_CLIPBOARD    = NO\n")
endif()

list(JOIN _extra_files " \\\n                         " _extra_files)
file(WRITE "${CMAKE_BINARY_DIR}/Doxyfile"
    "# Generated by cmake/Docs.cmake. Edit the Doxyfile in the source tree instead.\n"
    "@INCLUDE               = \"${CMAKE_SOURCE_DIR}/Doxyfile\"\n"
    "OUTPUT_DIRECTORY       = \"${CMAKE_BINARY_DIR}\"\n"
    "HTML_HEADER            = \"${_header}\"\n"
    "HTML_EXTRA_STYLESHEET  = \"${_theme_dir}/doxygen-awesome.css\" \\\n"
    "                         \"${_theme_dir}/doxygen-awesome-sidebar-only.css\" \\\n"
    "                         \"${_theme_dir}/doxygen-awesome-sidebar-only-darkmode-toggle.css\" \\\n"
    "                         \"${CMAKE_SOURCE_DIR}/docs/theme/cppfig.css\"\n"
    "HTML_EXTRA_FILES       = ${_extra_files}\n"
    "${_version_settings}"
)

# Doxygen runs from the source tree, so the Doxyfile's INPUT paths are relative
# to it, and writes the HTML to build/docs/html.
add_custom_target(docs
    COMMAND ${DOXYGEN_EXECUTABLE} "${CMAKE_BINARY_DIR}/Doxyfile"
    WORKING_DIRECTORY ${CMAKE_SOURCE_DIR}
    COMMENT "Generating Doxygen documentation"
    VERBATIM
)

find_package(Python3 COMPONENTS Interpreter QUIET)
if(Python3_FOUND)
    add_custom_target(docs-serve
        COMMAND ${Python3_EXECUTABLE} -m http.server 8080
        WORKING_DIRECTORY ${CMAKE_BINARY_DIR}/html
        COMMENT "Serving documentation at http://localhost:8080"
        VERBATIM
    )
endif()
